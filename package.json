{
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8099",
    "test": "node scratch/test_master_saas_100.mjs",
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./tailwind.input.css -o ./tailwind.css --minify",
    "build:js": "esbuild index_jsx.js --outfile=app.compiled.js --loader:.js=jsx --jsx-factory=React.createElement --jsx-fragment=React.Fragment",
    "build:dist": "npm run build && node scripts/build-dist.mjs",
    "deploy:build": "node scripts/generate-config.mjs production && npm run build:dist",
    "config": "node scripts/generate-config.mjs"
  },
  "dependencies": {
    "puppeteer": "^25.7.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.123.0"
  }
}
